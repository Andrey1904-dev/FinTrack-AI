# Supabase project used by the web app (both values are safe for the browser).
# Leave empty to use the project already connected to this repository.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Optional: public base path. GitHub Actions sets it to /<repo-name>/ automatically.
# VITE_BASE=/FinTrack-AI/

# NEVER put the Supabase service_role key, TELEGRAM_BOT_TOKEN or CRON_SECRET here:
# everything prefixed with VITE_ is shipped to the browser.
